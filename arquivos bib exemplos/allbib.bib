  Title                    = {Identification of coordination requirements: implications for the Design of collaboration and awareness tools},
  Author                   = {Marcelo Cataldo and Patrick A. Wagstrom and James D. Herbsleb and Kathleen M. Carley},
  Booktitle                = { 2006 20th Anniversary Conference on Computer Supported Cooperative Work},
  Year                     = {2006},

