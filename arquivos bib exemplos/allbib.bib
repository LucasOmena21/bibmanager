  Title                    = {Group awareness in distributed software development},
  Author                   = {Carl Gutwin and Reagan Penner and Kevin Schneider},
  Booktitle                = { 2004 ACM Conference on Computer Supported Cooperative Work},
  Year                     = {2004},

