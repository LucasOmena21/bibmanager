@InProceedings{Geyer.Richter.ea_2001,
  Title                    = {A team collaboration space supporting capture and access of virtual meetings},
  Author                   = {Werner Geyer and Heather Richter and Ludwin Fuchs and Tom Frauenhofer and Shahrokh Daijavad and Steven Poltrock},
