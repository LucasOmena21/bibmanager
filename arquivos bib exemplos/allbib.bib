  Title                    = {Cooperation and coordination concerns in a distributed software development project},
  Author                   = {Lucas D. Panjer and Daniela Damian and Margaret-Anne Storey},
  Booktitle                = { 2008 International Workshop on Cooperative and Human Aspects of Software Engineering},
  Year                     = {2008},

  Address                  = {New York, NY, USA},
