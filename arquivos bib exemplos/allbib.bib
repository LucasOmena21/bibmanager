@InCollection{Proenca.Moura.ea_2010,
  Title                    = {On the Use of Emerging Design as a Basis for Knowledge Collaboration},
  Author                   = {Tiago Proenca and Nilmax Moura and André {van der Hoek}},
  Booktitle                = {New Frontiers in Artificial Intelligence},
  Publisher                = {Springer Berlin / Heidelberg},
