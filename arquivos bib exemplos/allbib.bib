@article{Lindstrom2008,
  abstract = {In-vehicle spoken dialogue systems are gaining increased interest$\backslash$nby the automotive industry. They enable the driver to perform secondary$\backslash$ntasks (i.e. tasks not related to driving the vehicle) without having$\backslash$nto take her eyes off the road or her hands from the steering wheel.$\backslash$nDialogue systems also enable the driver to speak in a natural way,$\backslash$nwithout having to memorize commands or navigate through a menu structure.$\backslash$nIt is however crucial to take the cognitive load of the driver into$\backslash$nconsideration, in order to be able to adapt the dialogue system accordingly.$\backslash$nThis paper presents a user study where spoken dialogues between drivers$\backslash$nand passengers have been analysed to find out how spontaneous speech$\backslash$nis affected by driving and carrying out other activities that increase$\backslash$nthe cognitive load of the user. The results indicate systematic changes$\backslash$nin specific disfluency rates as the cognitive load increases.},
  author = {Lindstr{\"{o}}m, Anders and Villing, Jessica and Larsson, Staffan and Seward, Alexander and {\AA}berg, Nina and Holtelius, Cecilia},
  issn = {19909772},
  journal = {Proceedings of the Annual Conference of the International Speech Communication Association, INTERSPEECH},
  keywords = {Disfluencies,In-vehicle dialogue systems,Spoken language dialogue,Spontaneous speech},
  mendeley-groups = {Conversational/non-traditional Systems},
  pages = {1196--1199},
  title = {{The effect of cognitive load on disfluencies during in-vehicle spoken dialogue}},
  year = {2008}
}

@article{MartinovskyBilyana2006,
  abstract = {This paper focuses not on the detection and correction of specific errors in the interaction between machines and humans, but rather cases of massive deviation from the user's conversational expectations and desires. This can be the result of too many or too unusual errors, but also from dialogue strategies designed to minimize error, which make the interaction unnatural in other ways. We study causes of irritation such as over-fragmentation, over-clarity, over-coordination, over-directedness, and repetitiveness of verbal action, syntax, and intonation. Human reactions to these irritating features typically appear in the following order: tiredness, tolerance, anger, confusion, irony, humor, exhaustion, uncertainty, lack of desire to communicate. The studied features of human expressions of irritation in non-face-to-face interaction are: intonation, emphatic speech, elliptic speech, speed of speech, extra-linguistic signs, speed of verbal action, and overlap.},
  author = {Martinovsky, Bilyana and Traum, David},
  file = {:home/alipour/.local/share/data/Mendeley Ltd./Mendeley Desktop/Downloaded/Martinovsky, Traum - Unknown - The Error Is the Clue Breakdown In Human-Machine Interaction.pdf:pdf},
  mendeley-groups = {Conversational/non-traditional Systems},
  title = {{The Error Is the Clue : Breakdown In Human-Machine Interaction}},
  year = {2006}
}

@article{Filisko2004,
  abstract = {This paper describes our research on both the detection and subsequent resolution of recog-nition errors in spoken dialogue systems. The paper consists of two major components. The first half concerns the design of the error detec-tion mechanism for resolving city names in our MERCURY flight reservation system, and an in-vestigation of the behavioral patterns of users in subsequent subdialogues involving keypad entry for disambiguation. An important obser-vation is that, upon a request for keypad en-try, users are frequently unresponsive to the ex-tent of waiting for a time-out or hanging up the phone. The second half concerns a pilot ex-periment investigating the feasibility of replac-ing the solicitation of a keypad entry with that of a " speak-and-spell " entry. A novelty of our work is the introduction of a speech synthesizer to simulate the user, which facilitates develop-ment and evaluation of our proposed strategy. We have found that the speak-and-spell strat-egy is quite effective in simulation mode, but it remains to be tested in real user dialogues.},
  author = {Filisko, Edward and Seneff, Stephanie},
  file = {:home/alipour/.local/share/data/Mendeley Ltd./Mendeley Desktop/Downloaded/Filisko, Seneff - Unknown - Error Detection and Recovery in Spoken Dialogue Systems(2).pdf:pdf},
