@InProceedings{Fitzpatrick.Marshall.ea_2006,
  Title                    = {CVS integration with notification and chat: lightweight software team collaboration},
  Author                   = {Geraldine Fitzpatrick and Paul Marshall and Anthony Phillips},
  Booktitle                = { 2006 20th Anniversary Conference on Computer Supported Cooperative Work},
  Year                     = {2006},

