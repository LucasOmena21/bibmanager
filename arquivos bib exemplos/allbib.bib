@InCollection{Favela.Natsu.ea_2004,
  Title                    = {Empirical evaluation of collaborative support for distributed pair programming},
  Author                   = {Jesus Favela and Hiroshi Natsu and Cynthia Pérez and Omar Robles and Alberto L. Morán and Raul Romero and Ana M. Martínez-Enríquez and Dominique Decouchant},
  Booktitle                = {Groupware: Design, Implementation, and Use},
  Publisher                = {Springer Berlin Heidelberg},
  Year                     = {2004},
  Editor                   = {Gert-Jan de Vreede and LuisA. Guerrero and Gabriela Marín Raventós},
  Note                     = {cited By (since 1996) 0},
  Pages                    = {215--222},
  Series                   = {Lecture Notes in Computer Science},
  Volume                   = {3198},

  Abstract                 = {Pair programming is an Extreme Programming (XP) practice where two programmers work on a single computer to produce an artifact. Empirical evaluations have provided evidence that this technique results in higher quality code in half the time it would take an individual programmer. Distributed pair programming could facilitate opportunistic pair programming sessions with colleagues working in remote sites. In this paper we present the preliminary results of the empirical evaluation of the COPPER collaborative editor, developed explicitly to support pair programming. The evaluation was performed on three different conditions: pairs working collocated on a single computer; distributed pairs working in application sharing mode; and distributed pairs using collaboration aware facilities. In all three cases the subjects used the COPPER collaborative editor. The results support our hypothesis that distributed pairs could find the same amount of errors as their collocated counterparts. However, no evidence was found that the pairs that used collaborative awareness services had better code comprehension, as we had also hypothesized. Ã‚Â© Springer-Verlag 2004.},
  Affiliation              = {Departamento de Ciencias de la Computation, CICESE, Ensenada, Mexico; Laboratorire LSR, Grenoble, France; Depto. de Ing. Electrica, CINVESTAV-IPN, D.F., MÃƒÂ©xico},
