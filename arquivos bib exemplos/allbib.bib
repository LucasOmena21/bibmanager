@inproceedings{Higashinaka2017a,
  abstract = {Dialogue breakdown detection is a promising technique in di- alogue systems. To promote the research and development of such a technique, we have been organizing a dialogue break- down detection challenge where the task is to detect a system's inappropriate utterances that lead to dialogue breakdowns in chat-oriented dialogue. This paper describes the overview of dialogue breakdown detection challenge 3. Unlike the previ- ous two challenges held in Japan, we use datasets in two lan- guages: English and Japanese. Overall, 8 teams participated in the challenge, in which 6 teams worked on English and 4 teams on Japanese, with 2 teams working on both. This paper describes the task setting, datasets, and evaluation metrics for the challenge as well as the results of the submitted runs of the participants. Index},
