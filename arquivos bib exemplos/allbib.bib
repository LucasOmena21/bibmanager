@InProceedings{Dekel.Herbsleb_2008,
  Title                    = {Pushing relevant artifact annotations in collaborative software development},
  Author                   = {Uri Dekel and James D. Herbsleb},
  Booktitle                = { ACM 2008 Conference on Computer Supported Cooperative Work},
  Year                     = {2008},

  Address                  = {New York, NY, USA},
