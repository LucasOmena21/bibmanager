}

@InProceedings{Omoronyia.Sindre.ea_2009,
  Title                    = {Use case to source code traceability: The developer navigation view point},
  Author                   = {Inah Omoronyia and Guttorm Sindre and Marc Roper and John Ferguson and Murray Wood},
  Booktitle                = { IEEE International Conference on Requirements Engineering},
  Year                     = {2009},
  Note                     = {cited By (since 1996) 0},
  Pages                    = {237--242},
  Publisher                = {IEEE},
  Series                   = {RE '09},

  Abstract                 = {Requirements traceability is a challenge for modern software projects where task dependencies and technical expertise are spread across system developers, abstract model representations such as use cases, and a myriad of code artefacts. This paper presents an approach that monitors the navigation trails left by developers when building code artefacts to realise project use cases. These trails are analysed to generate a relevance ranking of entities that constitute a traceability link between uses cases and code artefacts and the developers responsible for them. Investigation in a software development scenario shows that a range of use case traceability questions can be answered through visualisations which present ordered relevance lists of the entities associated with use cases and by the use of trace graphs where the size of nodes show the importance, or 'information centrality', of system entities. Ã‚Â© 2009 IEEE.},
  Affiliation              = {Dept. of Computer and Information Science, Norwegian University of Science and Technology, Trondheim, Norway; Dept. of Computer and Information Sciences, University of Strathclyde, Glasgow, United Kingdom},
  Art_number               = {5328521},
