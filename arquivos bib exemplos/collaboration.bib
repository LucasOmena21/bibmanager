@InCollection{Favela.Natsu.ea_2004,
  Title                    = {Empirical evaluation of collaborative support for distributed pair programming},
  Author                   = {Jesus Favela and Hiroshi Natsu and Cynthia Pérez and Omar Robles and Alberto L. Morán and Raul Romero and Ana M. Martínez-Enríquez and Dominique Decouchant},
