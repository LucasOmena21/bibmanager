@InCollection{Gilbert.Karahalios_2007,
  Title                    = {CodeSaw: A social visualization of distributed software development},
  Author                   = {Eric Gilbert and Karrie Karahalios},
  Booktitle                = {Human-Computer Interaction -- INTERACT},
  Publisher                = {Springer Berlin Heidelberg},
  Year                     = {2007},
  Editor                   = {Cécilia Baranauskas and Philippe Palanque and Julio Abascal and Simone Diniz Junqueira Barbosa},
  Note                     = {cited By (since 1996) 4},
  Number                   = {PART II},
  Pages                    = {303--316},
  Series                   = {Lecture Notes In Computer Science},
  Volume                   = {4663},

  Abstract                 = {We present CodeSaw, a social visualization of distributed software development. CodeSaw visualizes a distributed software community from two important and independent perspectives: code repositories and project communication. By bringing together both shared artifacts (code) and the talk surrounding those artifacts (project mail), CodeSaw reveals group dynamics that lie buried in existing technologies. This paper describes the visualization and its design process. We apply CodeSaw to a popular open source project, showing how the visualization reveals group dynamics and individual roles. The paper ends with a discussion of the results of an online field study with prominent open source developers. The field study suggests that CodeSaw positively affects communities and provides incentives to distributed developers. Furthermore, an important design lesson from the field study leads us to introduce a novel interaction technique for social visualization called spatial messaging. Ã‚Â© IFIP International Federation for Information Processing 2007.},
  Affiliation              = {University of Illinois, Urbana-Champaign, IL, United States},
  Document_type            = {Conference Paper},
  Journal                  = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  Owner                    = {Steinmacher},
  Review                   = {Scopus Phase 4: (FINAL)},
  Source                   = {Scopus},
