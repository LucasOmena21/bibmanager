@InCollection{Patil.Kobsa.ea_2009,
  Title                    = {Interpersonal Privacy Management in Distributed Collaboration: Situational Characteristics and Interpretive Influences},
  Author                   = {Sameer Patil and Alfred Kobsa and Ajita John and Lynne Brotman and Doree Seligmann},
  Booktitle                = {Human-Computer Interaction â€“ INTERACT 2009},
  Publisher                = {Springer Berlin / Heidelberg},
  Year                     = {2009},
  Editor                   = {Tom Gross and Jan Gulliksen and Paula Kotzé and Lars Oestreicher and Philippe Palanque and Raquel Prates and Marco Winckler},
  Note                     = {10.1007/978-3-642-03658-3_19},
  Pages                    = {143--156},
  Series                   = {Lecture Notes in Computer Science},
  Volume                   = {5727},

  Abstract                 = {To understand how collaborators reconcile the often conflicting needs of awareness and privacy, we studied a large software development project in a multinational corporation involving individuals at sites in the U.S. and India. We present a theoretical framework describing privacy management practices and their determinants that emerged from field visits, interviews, and questionnaire responses. The framework identifies five relevant situational characteristics: issue(s) under consideration, physical place(s) involved in interaction(s), temporal aspects, affordances and limitations presented by technology, and nature of relationships among parties. Each actor, in turn, interprets the situation based on several simultaneous influences: self, team, work site, organization, and cultural environment. This interpretation guides privacy management action(s). Past actions form a feedback loop refining and/or reinforcing the interpretive influences. The framework suggests that effective support for privacy management will require that designers follow a socio-technical approach incorporating a wider scope of situational and interpretive differences.},
  Affiliation              = {University of California, Irvine Department of Informatics Irvine CA 92697 USA},
  Owner                    = {Steinmacher},
  Review                   = {Springer Phase 4: (FINAL)},
  Timestamp                = {2010.11.11},
  Url                      = {http://dx.doi.org/10.1007/978-3-642-03658-3_19}
}

